{
  "name": "dsp-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Interface web complète pour les processeurs t.racks DSP 206 et DSP 408 (Thomann)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dsp-studio/web",
    "dev:bridge": "node apps/bridge/src/main.ts --data .dev",
    "build": "npm run build -w @dsp-studio/web",
    "start": "node apps/bridge/src/main.ts",
    "test": "vitest run",
    "test:emulator": "vitest run apps/bridge/test/emulator.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
